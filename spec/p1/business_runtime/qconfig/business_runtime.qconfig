policy_ref: Q.SS.STD.P1.CONTRACT.BUSINESS_RUNTIME@V0186
one_operation_one_capability: true
formal_business_operation_type_forbidden: true
direct_same_domain_handler_import_forbidden: true
same_domain_semantic_call_method: internal_call_invoke
concrete_operation_execution_runtime_ref: Q.SS.STD.P0.CONTRACT.RUNTIME_CORE@V0134
verification_execution_owner_ref: Q.WORKFLOW.CONTRACT.SYSTEM_INTERFACE.WORKFLOW_EXECUTION_INVOKE@${CURRENT}
gate_verdict_authority_ref: Q.SS.STD.P1.CONTRACT.GATE_CAPABILITY@${CURRENT}
event_interface_dispatch_requires_exact_registered_binding: true
event_transport_or_caller_operation_selection_forbidden: true
event_publish_after_owner_operation_authoritative_fact_required: true
event_transport_is_non_semantic: true
event_transport_polling_or_cron_substitute_forbidden: true
event_listener_business_operation_forbidden: true
event_listener_transport_lifecycle_owned_by_p1: false
event_listener_transport_lifecycle_owned_by_repository_skeleton: false
event_listener_transport_lifecycle_requires_exact_capability_contract: true
event_listener_execution_runtime: EXISTING_P0_RUNTIME_ONLY
event_input_semantic_transformation_forbidden: true
overlay_slot_catalog_ref: Q.SS.STD.P1.CONTRACT.BUSINESS_RUNTIME@V0186#/overlay_slot_catalog
capability_general_slots_source: Q.SS.STD.META.CONTRACT.P1_CAPABILITY_MATERIALIZATION@${CURRENT}#/p1_general_runtime_overlay_export_contract
slot_ref_is_exact_predeclared_target_token_ref: true
field_name_only_slot_binding_forbidden: true
route_key_owner: P1_BUSINESS_RUNTIME
route_key_value_rule: EXACT_OPERATION_REF_BYTES
caller_or_capability_route_key_authority: false
route_tuple_mismatch_behavior: FAIL_CLOSED_ZERO_OPERATION_ATTEMPT
framework_anchor_crosswalk_ref: Q.SS.STD.P1.CONTRACT.BUSINESS_RUNTIME@V0186#/concrete_interface_framework_anchor_crosswalk
framework_anchor_selection_key: [surface, kind]
framework_anchor_zero_or_multiple_match_behavior: FAIL_CLOSED_BEFORE_IMPLEMENTATION_GENERATION
framework_anchor_creation_by_capability_or_materializer_forbidden: true
concrete_method_ref_separate_from_framework_entry_method_by_default: true
event_method_equality_owned_by_p1: true
