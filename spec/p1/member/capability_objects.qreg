      - message
    unknown_error_code_forbidden: true
  update_member_status:
    contract_ref: Q.MEMBERSHIP.CONTRACT.CAPABILITY.MEMBER@V0103#/stable_errors/update_member_status
    carrier_field: stable_error
    error_code_set:
    - MEMBER_IDENTITY_MISSING
    - MEMBER_NOT_FOUND
    - INVALID_STATE_TRANSITION
    - OPERATION_NOT_AUTHORIZED
    - CONCURRENT_MODIFICATION_CONFLICT
    - MEMBERSHIP_REQUIRED_INPUT_MISSING
    errors:
      MEMBER_IDENTITY_MISSING: 请求未携带已声明的会员标识，无法定位业务主体
      MEMBER_NOT_FOUND: 按已声明标识未找到会员；存在性 ≠ 关系有效 ≠ 具权益
      INVALID_STATE_TRANSITION: 目标状态或迁移不在已定义迁移规则内；迁移表确认前一律 FAIL_CLOSED（PD-4）
      OPERATION_NOT_AUTHORIZED: 授权规则待业务确认（PD-6），默认拒绝；权限不满足时不返回未经授权数据
      CONCURRENT_MODIFICATION_CONFLICT: 同一业务对象的并发修改冲突；重试与幂等策略待 PD-8
      MEMBERSHIP_REQUIRED_INPUT_MISSING: 请求违反该 Operation 已声明的必填字段要求。
    schema_language: JSON_SCHEMA_DRAFT_2020_12
    schema:
      type: object
      additionalProperties: false
      properties:
        code:
          type: string
          enum:
          - MEMBER_IDENTITY_MISSING
          - MEMBER_NOT_FOUND
          - INVALID_STATE_TRANSITION
          - OPERATION_NOT_AUTHORIZED
          - CONCURRENT_MODIFICATION_CONFLICT
          - MEMBERSHIP_REQUIRED_INPUT_MISSING
        message:
          type: string
          minLength: 1
      required:
      - code
      - message
    unknown_error_code_forbidden: true
  create_membership:
    contract_ref: Q.MEMBERSHIP.CONTRACT.CAPABILITY.MEMBER@V0103#/stable_errors/create_membership
    carrier_field: stable_error
    error_code_set:
    - MEMBER_IDENTITY_MISSING
    - MEMBER_NOT_FOUND
    - MEMBERSHIP_PLAN_NOT_FOUND
    - OPERATION_NOT_AUTHORIZED
    - DEPENDENCY_INFORMATION_INCOMPLETE
    - CONCURRENT_MODIFICATION_CONFLICT
    - MEMBERSHIP_REQUIRED_INPUT_MISSING
    - INVALID_BUSINESS_TIME
    - INVALID_STATE_TRANSITION
    - MEMBERSHIP_RELATION_CONFLICT
    errors:
      MEMBER_IDENTITY_MISSING: 请求未携带已声明的会员标识，无法定位业务主体
      MEMBER_NOT_FOUND: 按已声明标识未找到会员；存在性 ≠ 关系有效 ≠ 具权益
      MEMBERSHIP_PLAN_NOT_FOUND: 目标会员方案不存在或不可适用于该会员（方案所有权待 PD-2）
      OPERATION_NOT_AUTHORIZED: 授权规则待业务确认（PD-6），默认拒绝；权限不满足时不返回未经授权数据
      DEPENDENCY_INFORMATION_INCOMPLETE: 没有确定的方案 Owner/精确解析及适用条件依据时不可确立业务成功；不能将不透明引用视为已验证方案。
      CONCURRENT_MODIFICATION_CONFLICT: 同一业务对象的并发修改冲突；重试与幂等策略待 PD-8
      MEMBERSHIP_REQUIRED_INPUT_MISSING: 请求违反该 Operation 已声明的必填字段要求。
      INVALID_BUSINESS_TIME: Requested business time violates the explicitly declared effective-time boundary.
      INVALID_STATE_TRANSITION: 拟生效时点会员不处于允许建立关系的 active 状态。
      MEMBERSHIP_RELATION_CONFLICT: 拟生效时点已经存在生效关系或形成不可唯一解释的重叠区间。
    schema_language: JSON_SCHEMA_DRAFT_2020_12
    schema:
      type: object
      additionalProperties: false
      properties:
        code:
          type: string
          enum:
          - MEMBER_IDENTITY_MISSING
          - MEMBER_NOT_FOUND
          - MEMBERSHIP_PLAN_NOT_FOUND
          - OPERATION_NOT_AUTHORIZED
          - DEPENDENCY_INFORMATION_INCOMPLETE
          - CONCURRENT_MODIFICATION_CONFLICT
          - MEMBERSHIP_REQUIRED_INPUT_MISSING
          - INVALID_BUSINESS_TIME
          - INVALID_STATE_TRANSITION
          - MEMBERSHIP_RELATION_CONFLICT
        message:
          type: string
          minLength: 1
      required:
      - code
      - message
    unknown_error_code_forbidden: true
    x_error_addition_basis: 业务说明书该操作的显式失败分支（不是新增经营政策）。
  update_membership_plan:
    contract_ref: Q.MEMBERSHIP.CONTRACT.CAPABILITY.MEMBER@V0103#/stable_errors/update_membership_plan
    carrier_field: stable_error
    error_code_set:
    - MEMBER_IDENTITY_MISSING
    - MEMBER_NOT_FOUND
    - MEMBERSHIP_PLAN_NOT_FOUND
    - INVALID_STATE_TRANSITION
    - OPERATION_NOT_AUTHORIZED
    - CONCURRENT_MODIFICATION_CONFLICT
    - MEMBERSHIP_REQUIRED_INPUT_MISSING
    - INVALID_BUSINESS_TIME
    - MEMBERSHIP_NOT_FOUND
    - MEMBERSHIP_RELATION_CONFLICT
    - DEPENDENCY_INFORMATION_INCOMPLETE
    errors:
      MEMBER_IDENTITY_MISSING: 请求未携带已声明的会员标识，无法定位业务主体
      MEMBER_NOT_FOUND: 按已声明标识未找到会员；存在性 ≠ 关系有效 ≠ 具权益
      MEMBERSHIP_PLAN_NOT_FOUND: 目标会员方案不存在或不可适用于该会员（方案所有权待 PD-2）
      INVALID_STATE_TRANSITION: 目标状态或迁移不在已定义迁移规则内；迁移表确认前一律 FAIL_CLOSED（PD-4）
      OPERATION_NOT_AUTHORIZED: 授权规则待业务确认（PD-6），默认拒绝；权限不满足时不返回未经授权数据
      CONCURRENT_MODIFICATION_CONFLICT: 同一业务对象的并发修改冲突；重试与幂等策略待 PD-8
      MEMBERSHIP_REQUIRED_INPUT_MISSING: 请求违反该 Operation 已声明的必填字段要求。
      INVALID_BUSINESS_TIME: Requested business time violates the explicitly declared effective-time boundary.
      MEMBERSHIP_NOT_FOUND: 给定旧关系标识不存在或无法精确解析为属于该会员的关系。
      MEMBERSHIP_RELATION_CONFLICT: 新旧关系有效区间或并发替换产生冲突。
      DEPENDENCY_INFORMATION_INCOMPLETE: 目标方案或所需业务历史事实无法从权威来源完整解析。
    schema_language: JSON_SCHEMA_DRAFT_2020_12
    schema:
      type: object
      additionalProperties: false
      properties:
        code:
          type: string
          enum:
          - MEMBER_IDENTITY_MISSING
          - MEMBER_NOT_FOUND
          - MEMBERSHIP_PLAN_NOT_FOUND
          - INVALID_STATE_TRANSITION
