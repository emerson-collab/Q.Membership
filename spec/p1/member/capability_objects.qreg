stable_errors:
  create_member:
    contract_ref: Q.MEMBERSHIP.CONTRACT.CAPABILITY.MEMBER@V0103#/stable_errors/create_member
    carrier_field: stable_error
    error_code_set:
    - MEMBER_IDENTITY_MISSING
    - MEMBER_DUPLICATE_REGISTRATION
    - OPERATION_NOT_AUTHORIZED
    - DEPENDENCY_INFORMATION_INCOMPLETE
    - CONCURRENT_MODIFICATION_CONFLICT
    - MEMBERSHIP_REQUIRED_INPUT_MISSING
    errors:
      MEMBER_IDENTITY_MISSING: 请求未携带已声明的会员标识，无法定位业务主体
      MEMBER_DUPLICATE_REGISTRATION: 违反重复注册规则，未建立新会员身份（判定口径待 PD-1）
      OPERATION_NOT_AUTHORIZED: 授权规则待业务确认（PD-6），默认拒绝；权限不满足时不返回未经授权数据
      DEPENDENCY_INFORMATION_INCOMPLETE: 完成判定所需的必填依据（如资格判定五要素）不完整
      CONCURRENT_MODIFICATION_CONFLICT: 同一业务对象的并发修改冲突；重试与幂等策略待 PD-8
      MEMBERSHIP_REQUIRED_INPUT_MISSING: 请求违反该 Operation 已声明的必填字段要求。
    schema_language: JSON_SCHEMA_DRAFT_2020_12
    schema:
      type: object
      additionalProperties: false
      properties:
        code:
          type: string
          enum:
          - MEMBER_IDENTITY_MISSING
          - MEMBER_DUPLICATE_REGISTRATION
          - OPERATION_NOT_AUTHORIZED
          - DEPENDENCY_INFORMATION_INCOMPLETE
          - CONCURRENT_MODIFICATION_CONFLICT
          - MEMBERSHIP_REQUIRED_INPUT_MISSING
        message:
          type: string
          minLength: 1
      required:
      - code
      - message
    unknown_error_code_forbidden: true
  resolve_member:
    contract_ref: Q.MEMBERSHIP.CONTRACT.CAPABILITY.MEMBER@V0103#/stable_errors/resolve_member
    carrier_field: stable_error
    error_code_set:
    - MEMBER_IDENTITY_MISSING
    - MEMBER_NOT_FOUND
    - OPERATION_NOT_AUTHORIZED
    - MEMBERSHIP_REQUIRED_INPUT_MISSING
    errors:
      MEMBER_IDENTITY_MISSING: 请求未携带已声明的会员标识，无法定位业务主体
      MEMBER_NOT_FOUND: 按已声明标识未找到会员；存在性 ≠ 关系有效 ≠ 具权益
      OPERATION_NOT_AUTHORIZED: 授权规则待业务确认（PD-6），默认拒绝；权限不满足时不返回未经授权数据
      MEMBERSHIP_REQUIRED_INPUT_MISSING: 请求违反该 Operation 已声明的必填字段要求。
    schema_language: JSON_SCHEMA_DRAFT_2020_12
    schema:
      type: object
      additionalProperties: false
      properties:
        code:
          type: string
          enum:
          - MEMBER_IDENTITY_MISSING
          - MEMBER_NOT_FOUND
          - OPERATION_NOT_AUTHORIZED
          - MEMBERSHIP_REQUIRED_INPUT_MISSING
        message:
          type: string
          minLength: 1
      required:
      - code
      - message
    unknown_error_code_forbidden: true
  update_member_profile:
    contract_ref: Q.MEMBERSHIP.CONTRACT.CAPABILITY.MEMBER@V0103#/stable_errors/update_member_profile
    carrier_field: stable_error
    error_code_set:
    - MEMBER_IDENTITY_MISSING
    - MEMBER_NOT_FOUND
    - MEMBER_PROFILE_FIELD_NOT_MODIFIABLE
    - OPERATION_NOT_AUTHORIZED
    - DEPENDENCY_INFORMATION_INCOMPLETE
