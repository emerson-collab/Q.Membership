# SOURCE-BOUND candidate projection; NOT a new business authority, whitelist, Gate or activation receipt.
# exact_member_owner: Q.MEMBERSHIP.CONTRACT.CAPABILITY.MEMBER@V0103
# governed_semantic_standard: Q.SS.STD.META.CONTRACT.P1_CAPABILITY_MATERIALIZATION@V0117
# source_status: candidate; exact external hash / actor authority still unresolved.
q_header: '1'
q_id: Q.MEMBERSHIP.CONTRACT.CAPABILITY.MEMBER
q_version: V0103
q_stage: P1
q_role: capability_objects_registry_projection
q_status: candidate

type_closure:
  closure_mode: EXACT_OWNER_LOCAL_PROPOSED_SCHEMAS
  schemas:
    member:
      type: object
      additionalProperties: false
      properties:
        member_ref:
          type: string
          minLength: 1
        member_status:
          type: string
          minLength: 1
          x_owner_decision_refs:
          - PD-4
          x_exact_business_enum_owner_decision_ref: PD-4
          x_free_string_does_not_constitute_confirmed_business_state_set: false
          enum:
          - active
          - terminated
          x_design_status: EXPLICIT_PROPOSED_ENUM_PENDING_OWNER_APPROVAL
        member_profile:
          type: object
          additionalProperties: false
          properties:
            display_name:
              type: string
              minLength: 1
              maxLength: 256
          required:
          - display_name
          description: 仅含已获准展示的资料；不默认披露 contact_email。
      required:
      - member_ref
      - member_status
      - member_profile
    membership:
      type: object
      additionalProperties: false
      properties:
        membership_ref:
          type: string
          minLength: 1
        member_ref:
          type: string
          minLength: 1
        plan_ref:
          type: string
          minLength: 1
        membership_status:
          type: string
          minLength: 1
          x_owner_decision_refs:
          - PD-4
          x_exact_business_enum_owner_decision_ref: PD-4
          x_free_string_does_not_constitute_confirmed_business_state_set: false
          enum:
          - active
          - replaced
          x_design_status: EXPLICIT_PROPOSED_ENUM_PENDING_OWNER_APPROVAL
        effective_time:
          type: string
          format: date-time
          x_owner_decision_refs:
          - PD-4
        termination_time:
          anyOf:
          - type: string
            format: date-time
          - type: 'null'
          x_owner_decision_refs:
          - PD-4
      required:
      - membership_ref
      - member_ref
      - plan_ref
      - membership_status
      - effective_time
      allOf:
      - if:
          properties:
            membership_status:
              const: replaced
          required:
          - membership_status
        then:
          required:
          - termination_time
          properties:
            termination_time:
              type: string
              format: date-time
      - if:
          properties:
            membership_status:
              const: active
          required:
          - membership_status
        then:
          properties:
            termination_time:
              type: 'null'
      x_runtime_interval_constraint: effective_time < termination_time when status=replaced; JSON Schema cannot compare timestamps,
        enforced by exact operation rule.
    eligibility_decision:
      type: object
      additionalProperties: false
      properties:
        eligible:
          type: boolean
        basis:
          type: object
          additionalProperties: false
          properties:
            reason_code:
              type: string
              enum:
              - MEMBERSHIP_VALID
              - MEMBER_TERMINATED
              - NO_EFFECTIVE_MEMBERSHIP
            check_purpose:
              type: string
              enum:
              - membership_validity
            decision_time:
              type: string
              format: date-time
            member_status_at_decision:
              type: string
              enum:
              - active
              - terminated
            membership_refs_considered:
              type: array
              items:
                type: string
                minLength: 1
              uniqueItems: true
              maxItems: 1
          required:
          - reason_code
          - check_purpose
          - decision_time
          - member_status_at_decision
          - membership_refs_considered
      required:
      - eligible
      - basis
      oneOf:
      - properties:
          eligible:
            const: true
          basis:
            properties:
              reason_code:
                const: MEMBERSHIP_VALID
              member_status_at_decision:
                const: active
              membership_refs_considered:
                minItems: 1
                maxItems: 1
      - properties:
          eligible:
            const: false
          basis:
            properties:
              reason_code:
                const: MEMBER_TERMINATED
              member_status_at_decision:
                const: terminated
              membership_refs_considered:
                maxItems: 1
      - properties:
          eligible:
            const: false
          basis:
            properties:
              reason_code:
                const: NO_EFFECTIVE_MEMBERSHIP
              member_status_at_decision:
                const: active
              membership_refs_considered:
                maxItems: 0
      x_reason_priority: PROPOSED_FROM_BUSINESS_DESCRIPTION_LINES_106_110_NOT_OWNER_APPROVED
    membership_plan_resolution_binding:
      type: object
      additionalProperties: false
      properties:
        membership_plan_ref:
          type: string
          minLength: 1
        name:
          type: string
          minLength: 1
        benefit_refs:
          type: array
          items:
            type: string
          minItems: 0
          uniqueItems: true
        commercial_terms_ref:
          type: string
          minLength: 1
        state:
          type: string
          enum:
          - active
          - inactive
      required:
      - membership_plan_ref
      - name
      - benefit_refs
      - commercial_terms_ref
      - state
  transitive_public_type_closure_complete: true
  undeclared_type_inference_forbidden: true
