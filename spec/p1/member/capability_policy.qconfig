operational_relations:
  mode: DECLARED
  relations:
    create_verify_membership_plan:
      relation_ref: Q.MEMBERSHIP.CONTRACT.CAPABILITY.MEMBER@V0104#/operational_relations/relations/create_verify_membership_plan
      consumer_operation_ref: Q.MEMBERSHIP.CONTRACT.CAPABILITY.MEMBER@V0104#/operations/create_membership
      local_dependency_ref: q.membership.member.dependency.membership_plan
      provider_capability_contract_ref: Q.MEMBERSHIP.CONTRACT.CAPABILITY.MEMBERSHIP_PLAN@V0105
      provider_operation_ref: Q.MEMBERSHIP.CONTRACT.CAPABILITY.MEMBERSHIP_PLAN@V0105#/operations/resolve_membership_plan
      provider_interface_ref: Q.MEMBERSHIP.CONTRACT.CAPABILITY.MEMBERSHIP_PLAN@V0105#/interfaces/membership_plan_resolution_invoke
      connection_mode: INTRA_DOMAIN
      invocation_mode: SINGLE
      response_aggregation_mode: DIRECT
      for_each_error_mode: null
      request_mapping:
      - provider_request_field_path: membership_plan_ref
        source_kind: CONSUMER_INPUT
        consumer_source_path: plan_ref
      response_mapping:
      - provider_runtime_result_path: membership_plan
        consumer_binding_key: membership_plan_resolution
        consumer_binding_schema_ref: Q.MEMBERSHIP.CONTRACT.CAPABILITY.MEMBER@V0104#/type_closure/schemas/membership_plan_resolution_binding
        required: true
      stable_error_mode: PRESERVE_EXACT
      consumer_post_resolution_required_condition: membership_plan.state == active
    update_verify_target_plan:
      relation_ref: Q.MEMBERSHIP.CONTRACT.CAPABILITY.MEMBER@V0104#/operational_relations/relations/update_verify_target_plan
      consumer_operation_ref: Q.MEMBERSHIP.CONTRACT.CAPABILITY.MEMBER@V0104#/operations/update_membership_plan
      local_dependency_ref: q.membership.member.dependency.membership_plan
      provider_capability_contract_ref: Q.MEMBERSHIP.CONTRACT.CAPABILITY.MEMBERSHIP_PLAN@V0105
      provider_operation_ref: Q.MEMBERSHIP.CONTRACT.CAPABILITY.MEMBERSHIP_PLAN@V0105#/operations/resolve_membership_plan
      provider_interface_ref: Q.MEMBERSHIP.CONTRACT.CAPABILITY.MEMBERSHIP_PLAN@V0105#/interfaces/membership_plan_resolution_invoke
      connection_mode: INTRA_DOMAIN
      invocation_mode: SINGLE
      response_aggregation_mode: DIRECT
      for_each_error_mode: null
      request_mapping:
      - provider_request_field_path: membership_plan_ref
        source_kind: CONSUMER_INPUT
        consumer_source_path: target_plan_ref
      response_mapping:
