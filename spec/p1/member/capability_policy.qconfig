# 统一会员能力 V0103 — Capability Policy Config（物理投影）
# projection_only: true
# source_of_truth:
#   - Q.MEMBERSHIP.CONTRACT.CAPABILITY.MEMBER@V0103#/capability_rules
#   - Q.MEMBERSHIP.CONTRACT.CAPABILITY.MEMBER@V0103#/rule_bindings
#   - Q.MEMBERSHIP.CONTRACT.CAPABILITY.MEMBER@V0103#/permission_model
# 注：本文件中的候选业务规则在 Owner 批准前不构成生产经营政策；
#     授权模型当前为 DENY_ALL，未解析可信 Actor 映射。
q_header: '1'
q_id: Q.MEMBERSHIP.CONTRACT.CAPABILITY.MEMBER
q_version: V0103
q_stage: P1
q_role: capability_policy_projection

permission_model:
  mode: DECLARED
  default_decision: DENY
  effective_until_approved_actor_mapping: DENY_ALL
  denial_stable_error_code: OPERATION_NOT_AUTHORIZED
  applies_to_operations:
    - create_member
    - resolve_member
    - update_member_profile
    - update_member_status
    - create_membership
    - update_membership_plan
    - lookup_membership
    - evaluate_membership_eligibility
    - resolve_membership
  internal_purpose_required:
    resolve_membership: true
  x_missing_exact_actor_identity_and_auth_rule: true

rules:
  R-REQUIRED-DATA-COMPLETENESS: 请求需通过固定 Owner Schema：身份二元键、非空档案、非空变更、合法时间、方案精确可解析；不得从扩展字段补造语义。
  R-DUPLICATE-REGISTRATION: 注册以 (identity_namespace, identity_value) 原始字节组合作精确唯一键；同键存在即 MEMBER_DUPLICATE_REGISTRATION；并发由单一原子唯一性写入保证。
  R-IDENTITY-STABLE: 会员身份必须稳定且可精确解析；稳定会员标识不得因资料修改而变化。
  R-THREE-STATE-SEPARATION: 会员档案状态、会员关系状态、资格判断结果三类状态不得混用。
  R-EXISTENCE-NOT-ELIGIBILITY: 会员存在、会员关系时间有效和会员权益履约为三个独立事实；本能力只判定 membership_validity。
  R-ELIGIBILITY-BASIS: 仅支持 membership_validity；先验证必需历史事实与合法 decision_time，不能把不可判定映射为 false。eligible=true 当且仅当该时点会员 active 且恰好一条有效关系。
  R-ELIGIBILITY-DECISION: eligible=false 是正常判定结果，不触发 StableError；不得把 false 解释为 true。
  R-CONSISTENT-RESULT: 相同会员、用途、历史时点和权威业务事实得出一致结果；失败写操作保持原状。
  R-PLAN-EXISTENCE: 建立及替换关系时必须精确调用 Membership Plan Provider 的 resolve_membership_plan，只接受 state=active 的真实方案。
  R-STATE-TRANSITION-GUARD: member 仅 active->terminated；membership 仅 active->replaced；终态无隐式恢复与重叠转移。
  R-AUTH-DEFAULT-DENY: 所有 9 个 Operation 必须有真实业务授权；未声明、不可验证或无法映射到可信 Actor 的调用一律拒绝。
  R-EFFECTIVE-TIME-MEMBER-STATUS: create_membership 只在拟生效时点 member_status=active 时可建立关系，历史时点必须读状态历史。
  R-TEMPORAL-BOUNDS: 未填时点使用提交时点；显式时点 <= 提交时点；建立关系不能早于会员创建，更换不能早于旧关系开始。
  R-ONE-EFFECTIVE-RELATION: 任一会员在同一时点最多一条生效方案关系；创建/更换不得造成有效区间重叠，并发原子保护。
  R-ATOMIC-RELATION-REPLACEMENT: 更换方案原子结束旧关系并创建新关系；历史不覆盖，响应必须有新旧关系标识。
  R-HISTORICAL-INTERVAL-LOOKUP: 关系查询按 effective_time <= as_of_time < termination_time 选择至多一条；冲突不能伪造成功。
  R-ELIGIBILITY-REASON-PRIORITY: 资格原因先判断会员在判定时点是否 terminated，再在 active 情形判断关系有效性；数据未知不能返回 false。
  R-OWNER-PROFILE-DISCLOSURE: 公开查询默认仅提供展示资料，不因保存 contact_email 就公开联系方式。
  R-RETRY-NO-DUPLICATE-RELATION: 重复创建及重复更换按已有业务状态重新判断；replaced 旧关系不得产生第二个后继。
  R-EXACT-INTERNAL-MEMBERSHIP-READ: 内部 resolve_membership 严格按 membership_ref 查一条历史记录，绝不自动选最新。
  R-NO-PAYMENT-OR-ENTITLEMENT-INFERENCE: 建立关系不要求支付凭据；任何写操作不产生支付、订单或权益履约事实。

rule_bindings:
  RB-01:
    rule: R-REQUIRED-DATA-COMPLETENESS
    phase: REQUEST_VALIDATION
    realization: OPERATION_ENFORCED
    applies_to: ALL_OPERATIONS
    failure_code: MEMBERSHIP_REQUIRED_INPUT_MISSING
  RB-02:
    rule: R-DUPLICATE-REGISTRATION
    phase: PRECONDITION
    realization: OPERATION_ENFORCED
    applies_to: [create_member]
    failure_code: MEMBER_DUPLICATE_REGISTRATION
  RB-03:
    rule: R-IDENTITY-STABLE
    phase: REQUEST_VALIDATION
    realization: OPERATION_ENFORCED
    applies_to: [update_member_profile]
    failure_code: MEMBER_PROFILE_FIELD_NOT_MODIFIABLE
  RB-04:
    rule: R-THREE-STATE-SEPARATION
    phase: INFORMATIONAL
    realization: INFORMATIONAL
    applies_to: []
  RB-05:
    rule: R-EXISTENCE-NOT-ELIGIBILITY
    phase: INFORMATIONAL
    realization: INFORMATIONAL
    applies_to: [evaluate_membership_eligibility]
  RB-06:
    rule: R-ELIGIBILITY-BASIS
    phase: PRECONDITION
    realization: OPERATION_ENFORCED
    applies_to: [evaluate_membership_eligibility]
    failure_code: DEPENDENCY_INFORMATION_INCOMPLETE
    x_no_false_eligibility_for_missing_basis: true
  RB-07:
    rule: R-ELIGIBILITY-DECISION
    phase: INFORMATIONAL
    realization: INFORMATIONAL
    applies_to: [evaluate_membership_eligibility]
  RB-08:
    rule: R-CONSISTENT-RESULT
    phase: INFORMATIONAL
    realization: INFORMATIONAL
    applies_to: [evaluate_membership_eligibility]
  RB-09:
    rule: R-PLAN-EXISTENCE
    phase: DEPENDENCY_PRECONDITION
    realization: OPERATION_ENFORCED
    applies_to: [create_membership, update_membership_plan]
    operational_relations: [create_verify_membership_plan, update_verify_target_plan]
    failure_code: MEMBERSHIP_PLAN_NOT_FOUND
  RB-10:
    rule: R-STATE-TRANSITION-GUARD
    phase: STATE_GUARD
    realization: OPERATION_ENFORCED
    applies_to: [update_member_status, update_membership_plan]
    failure_code: INVALID_STATE_TRANSITION
  RB-11:
    rule: R-AUTH-DEFAULT-DENY
    phase: AUTHORIZATION
    realization: OPERATION_ENFORCED
    applies_to: ALL_OPERATIONS
    failure_code: OPERATION_NOT_AUTHORIZED
  RB-12:
    rule: R-EFFECTIVE-TIME-MEMBER-STATUS
    phase: PRECONDITION
    realization: OPERATION_ENFORCED
    applies_to: [create_membership]
    failure_code: INVALID_STATE_TRANSITION
  RB-13:
    rule: R-TEMPORAL-BOUNDS
    phase: PRECONDITION
    realization: OPERATION_ENFORCED
    applies_to: [create_membership, update_membership_plan]
    failure_code: INVALID_BUSINESS_TIME
  RB-14:
    rule: R-ONE-EFFECTIVE-RELATION
    phase: PRECONDITION
    realization: OPERATION_ENFORCED
    applies_to: [create_membership, update_membership_plan]
    failure_code: MEMBERSHIP_RELATION_CONFLICT
  RB-15:
    rule: R-ATOMIC-RELATION-REPLACEMENT
    phase: POSTCONDITION
    realization: OPERATION_ENFORCED
    applies_to: [update_membership_plan]
    failure_code: CONCURRENT_MODIFICATION_CONFLICT
  RB-16:
    rule: R-HISTORICAL-INTERVAL-LOOKUP
    phase: PRECONDITION
    realization: OPERATION_ENFORCED
    applies_to: [lookup_membership, evaluate_membership_eligibility]
    failure_code: DEPENDENCY_INFORMATION_INCOMPLETE
  RB-17:
    rule: R-ELIGIBILITY-REASON-PRIORITY
    phase: POSTCONDITION
    realization: OPERATION_ENFORCED
    applies_to: [evaluate_membership_eligibility]
    failure_code: DEPENDENCY_INFORMATION_INCOMPLETE
  RB-18:
    rule: R-OWNER-PROFILE-DISCLOSURE
    phase: POSTCONDITION
    realization: OPERATION_ENFORCED
    applies_to: [resolve_member]
    failure_code: OPERATION_NOT_AUTHORIZED
  RB-19:
    rule: R-RETRY-NO-DUPLICATE-RELATION
    phase: PRECONDITION
    realization: OPERATION_ENFORCED
    applies_to: [create_member, create_membership, update_membership_plan]
    failure_code: CONCURRENT_MODIFICATION_CONFLICT
  RB-20:
    rule: R-EXACT-INTERNAL-MEMBERSHIP-READ
    phase: PRECONDITION
    realization: OPERATION_ENFORCED
    applies_to: [resolve_membership]
    failure_code: MEMBERSHIP_NOT_FOUND
  RB-21:
    rule: R-NO-PAYMENT-OR-ENTITLEMENT-INFERENCE
    phase: INFORMATIONAL
    realization: INFORMATIONAL
    applies_to: []

operational_relations:
  create_verify_membership_plan:
    consumer_operation: create_membership
    provider_operation: resolve_membership_plan
    request_mapping: plan_ref -> membership_plan_ref
    response_binding: membership_plan_resolution
    required_condition: membership_plan.state == active
    stable_error_mode: PRESERVE_EXACT
  update_verify_target_plan:
    consumer_operation: update_membership_plan
    provider_operation: resolve_membership_plan
    request_mapping: target_plan_ref -> membership_plan_ref
    response_binding: membership_plan_resolution
    required_condition: membership_plan.state == active
    stable_error_mode: PRESERVE_EXACT
