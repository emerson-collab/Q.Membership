{
  "name": "@q-system/p0-runtime-core",
  "version": "0.13.3",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck",
    "web": "node --experimental-transform-types web/server.ts",
    "test": "node --experimental-transform-types --test",
    "smoke": "npm run smoke:p0",
    "test:p0": "node --experimental-transform-types --test tests/p0/p0_runtime_core.test.ts",
    "smoke:p0": "node --experimental-transform-types --test --test-name-pattern=\"P0 smoke\" tests/p0/p0_runtime_core.test.ts",
    "test:member:source": "node tools/member/verify_v0117_source_projection.mjs",
    "test:member:boundary": "node --experimental-transform-types --test tests/p1/export/member/v0117_boundary.node.test.ts",
    "test:member:branches": "node tools/member/verify_v0117_branches.mjs",
    "typecheck:member": "tsc --noEmit -p tsconfig.member.json",
    "test:member:whitelist": "node tools/member/verify_v0104_compact_whitelist.mjs",
    "inspect:member:p1-handoff": "node tools/member/inspect_p1_handoff.mjs",
    "check:member:triad-ready": "node tools/member/inspect_p1_handoff.mjs --require-ready",
    "test:member:handoff": "node --test tests/p1/export/member/handoff_preflight.node.test.mjs"
  },
  "imports": {
    "#q/p0/runtime_contract": "./src/p0/runtime_contract.ts",
    "#q/p0/stage_handler": "./src/p0/stage_handler.ts",
    "#q/*": "./src/*"
  },
  "devDependencies": {
    "@types/node": "22.17.0",
    "typescript": "5.8.3",
    "vitest": "^5.0.4"
  }
}
